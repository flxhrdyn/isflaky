# Copy to .env and fill in. .env is gitignored and must never be committed.

# GitHub API, used only by the dataset miner (isflaky-mine).
# Create a CLASSIC personal access token with NO scopes checked: every repository
# the miner reads is public, and an unscoped token still raises the rate limit
# from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# TypeSafe Jev, used by the decision engine and the benchmark.
# https://typesafe.ai - early access console.
TYPESAFE_API_KEY=

# Groq, used only by the paid LLM baseline at n between 300 and 500.
# Leave blank to run the free heuristic baselines alone.
# Default baseline model: llama-3.1-8b-instant
GROQ_API_KEY=
